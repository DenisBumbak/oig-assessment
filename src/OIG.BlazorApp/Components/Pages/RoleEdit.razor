@page "/roles/new"
@page "/roles/{Id:guid}"
@rendermode InteractiveServer
@inject RoleService RoleSvc
@inject OrganizationService OrgSvc
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "New Role" : "Edit Role")</PageTitle>

<h3>@(_isNew ? "New Role" : "Edit Role")</h3>

@if (_loading)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="_form" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="_form.Name" />
        </div>
        @if (_isNew)
        {
            <div class="mb-3">
                <label class="form-label">Organization</label>
                <select class="form-select" @bind="_form.OrganizationId">
                    <option value="">None (global)</option>
                    @if (_orgs is not null)
                    {
                        @foreach (var org in FlattenOrgs(_orgs.Roots))
                        {
                            <option value="@org.Id">@org.Prefix@org.Name</option>
                        }
                    }
                </select>
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Permissions</label>
            @foreach (var p in Enum.GetValues<Permission>().Where(p => p != Permission.None))
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@_selectedPermissions.Contains(p)"
                           @onchange="e => TogglePermission(p, (bool)(e.Value ?? false))" />
                    <label class="form-check-label">@p</label>
                </div>
            }
        </div>
        <button type="submit" class="btn btn-success">Save</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Cancel</button>
        @if (!_isNew)
        {
            <button type="button" class="btn btn-danger ms-2" @onclick="Delete">Delete</button>
        }
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger mt-3">@_error</div>
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private bool _isNew => !Id.HasValue;
    private bool _loading = true;
    private string? _error;
    private RoleFormModel _form = new();
    private OrganizationHierarchyResponse? _orgs;
    private HashSet<Permission> _selectedPermissions = new();

    protected override async Task OnInitializedAsync()
    {
        _orgs = await OrgSvc.GetHierarchyAsync();

        if (!_isNew)
        {
            var role = await RoleSvc.GetByIdAsync(Id!.Value);
            if (role is not null)
            {
                _form = new RoleFormModel { Name = role.Name, OrganizationId = role.OrganizationId?.ToString() ?? "" };
                _selectedPermissions = role.Permissions.ToHashSet();
            }
        }
        _loading = false;
    }

    private void TogglePermission(Permission p, bool isChecked)
    {
        if (isChecked) _selectedPermissions.Add(p);
        else _selectedPermissions.Remove(p);
    }

    private async Task Save()
    {
        _error = null;
        try
        {
            if (_isNew)
            {
                var orgId = Guid.TryParse(_form.OrganizationId, out var oid) ? oid : (Guid?)null;
                await RoleSvc.CreateAsync(new CreateRoleRequest(_form.Name, orgId, _selectedPermissions.ToList()));
            }
            else
            {
                await RoleSvc.UpdateAsync(Id!.Value, new UpdateRoleRequest(_form.Name, _selectedPermissions.ToList()));
            }
            Nav.NavigateTo("/roles");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Delete()
    {
        if (!Id.HasValue) return;
        try
        {
            await RoleSvc.DeleteAsync(Id.Value);
            Nav.NavigateTo("/roles");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void GoBack() => Nav.NavigateTo("/roles");

    private IEnumerable<(Guid Id, string Name, string Prefix)> FlattenOrgs(List<OrganizationNodeDto> nodes, int depth = 0)
    {
        foreach (var n in nodes)
        {
            yield return (n.Id, n.Name, new string('\u00A0', depth * 3));
            foreach (var child in FlattenOrgs(n.Children, depth + 1))
                yield return child;
        }
    }

    public class RoleFormModel
    {
        public string Name { get; set; } = "";
        public string OrganizationId { get; set; } = "";
    }
}
