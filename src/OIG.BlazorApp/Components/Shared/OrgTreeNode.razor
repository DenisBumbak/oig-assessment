<div style="margin-left: @(Depth * 20)px; padding: 2px 0;">
    <span style="cursor: pointer; font-weight: @(Node.Id == SelectedId ? "bold" : "normal")"
          @onclick="() => OnSelect.InvokeAsync(Node.Id)">
        @(Node.Children.Count > 0 ? "▸ " : "  ")@Node.Name
    </span>
    <button class="btn btn-link btn-sm p-0 ms-2" @onclick="() => CreateChild()">+</button>
</div>

@foreach (var child in Node.Children)
{
    <OrgTreeNode Node="child" SelectedId="SelectedId" OnSelect="OnSelect" Depth="Depth + 1" />
}

@code {
    [Parameter, EditorRequired] public OrganizationNodeDto Node { get; set; } = default!;
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
    [Parameter] public int Depth { get; set; }

    private async Task CreateChild()
    {
        await OnSelect.InvokeAsync(Node.Id);
    }
}
